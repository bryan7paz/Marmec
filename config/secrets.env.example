# ════════════════════════════════════════════════════════════════
#  Credenciais — copie para config/secrets.env e preencha
# ════════════════════════════════════════════════════════════════

# ── Banco de dados ──────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://regulatory:regulatory@localhost:5432/regulatory

# ── API Security ────────────────────────────────────────────────
# Chave única para autenticação da API (deixe vazio = API aberta)
API_KEY=

# Múltiplas chaves separadas por vírgula (opcional)
# API_KEYS=chave1,chave2,chave3

# ── LLM (preencha ao menos um) ─────────────────────────────────
# Google Gemini (gratuito) — https://aistudio.google.com
GOOGLE_API_KEY=

# NVIDIA NIM (gratuito) — https://build.nvidia.com
NVIDIA_API_KEY=

# ── IMODOCS (opcional) ─────────────────────────────────────────
IMODOCS_USER=
IMODOCS_PASSWORD=

# ── Scheduler ───────────────────────────────────────────────────
SCHEDULE_HOUR=06
SCHEDULE_TIMEZONE=America/Sao_Paulo
